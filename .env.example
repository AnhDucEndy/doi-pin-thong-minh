# Copy to .env and replace all placeholders; do not commit .env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_SECRET
POSTGRES_PORT=5432
MIGRATOR_PASSWORD=REPLACE_WITH_RANDOM_MIGRATOR_SECRET
RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_RUNTIME_SECRET
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:REPLACE_WITH_RANDOM_ADMIN_SECRET@127.0.0.1:5432/doi_pin
MIGRATION_DATABASE_URL=postgresql+psycopg://doi_pin_migrator:REPLACE_WITH_RANDOM_MIGRATOR_SECRET@127.0.0.1:5432/doi_pin
DATABASE_URL=postgresql+psycopg://doi_pin_runtime:REPLACE_WITH_RANDOM_RUNTIME_SECRET@127.0.0.1:5432/doi_pin
DATABASE_SCHEMA=doi_pin
DEMO_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_LOGIN_PASSWORD
DEMO_CUSTOMER_PASSWORD=REPLACE_WITH_RANDOM_CUSTOMER_LOGIN_PASSWORD
DEMO_TECHNICIAN_PASSWORD=REPLACE_WITH_RANDOM_TECHNICIAN_LOGIN_PASSWORD
DEMO_DEVICE_KEY_S01=REPLACE_WITH_RANDOM_DEVICE_KEY
DEMO_DEVICE_KEY_S02=REPLACE_WITH_RANDOM_DEVICE_KEY
# Keep this stable for safe idempotent delivery of newly registered device keys.
DEVICE_KEY_DERIVATION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Phase 6 private mock only; use distinct random values, at least 32 characters.
PAYMENT_SERVICE_KEY=REPLACE_WITH_RANDOM_SERVICE_SECRET
PAYMENT_CALLBACK_KEY=REPLACE_WITH_RANDOM_CALLBACK_SECRET
PAYMENT_MOCK_URL=http://127.0.0.1:8001
PAYMENT_LEDGER_PATH=.local/payment/ledger.sqlite3
PAYMENT_MOCK_SCENARIO=success
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/v1/payment-events
