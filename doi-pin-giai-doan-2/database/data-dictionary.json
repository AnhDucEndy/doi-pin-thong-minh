      ],
      [
        "policy_snapshot",
        "jsonb NOT NULL",
        "Snapshot bất biến để không đổi điều kiện giữa lượt"
      ],
      [
        "old_battery_id",
        "uuid REFERENCES batteries(id)",
        "Pin khách phải trả, xác định khi giữ tài nguyên"
      ],
      [
        "new_battery_id",
        "uuid REFERENCES batteries(id)",
        "Pin được giữ để cấp"
      ],
      [
        "return_compartment_id",
        "uuid",
        "Ngăn nhận"
      ],
      [
        "supply_compartment_id",
        "uuid",
        "Ngăn cấp"
      ],
      [
        "amount_minor",
        "bigint CHECK (amount_minor > 0)",
        "Phí VND nguyên, chốt khi reserve"
      ],
      [
        "currency",
        "text NOT NULL DEFAULT 'VND' CHECK (currency='VND')",
        "Demo chỉ VND"
      ],
      [
        "consented_at",
        "timestamptz",
        "Chấp thuận phí trước yêu cầu thu"
      ],
      [
        "reservation_expires_at",
        "timestamptz",
        "Chỉ tự hết hạn khi RESERVED chưa gửi thu"
      ],
      [
        "return_observed_at",
        "timestamptz",
        "Bằng chứng nhận pin cũ + cửa đóng"
      ],
      [
        "pickup_observed_at",
        "timestamptz",
        "Bằng chứng lấy pin mới + cửa đóng"
      ],
      [
        "review_reason",
        "text",
        "Lý do chờ xử lý"
      ],
      [
        "closed_at",
        "timestamptz",
        "Thời điểm trạng thái kết thúc"
      ],
      [
        "version",
        "integer NOT NULL DEFAULT 1 CHECK (version > 0)",
        "Khóa lạc quan; tăng sau mỗi cập nhật nghiệp vụ"
      ],
      [
        "created_at",
        "timestamptz NOT NULL DEFAULT now()",
        "Thời điểm tạo UTC"
      ]
    ],
    "constraints": [
      "FOREIGN KEY (return_compartment_id, station_id) REFERENCES compartments(id, station_id)",
      "FOREIGN KEY (supply_compartment_id, station_id) REFERENCES compartments(id, station_id)",
      "CHECK ((verified_via='QR' AND qr_challenge_id IS NOT NULL AND credential_id IS NULL) OR (verified_via='RFID' AND credential_id IS NOT NULL AND qr_challenge_id IS NULL))",
      "CHECK (old_battery_id IS NULL OR new_battery_id IS NULL OR old_battery_id <> new_battery_id)",
      "CHECK (return_compartment_id IS NULL OR supply_compartment_id IS NULL OR return_compartment_id <> supply_compartment_id)",
      "CHECK (state IN ('VERIFIED','CANCELLED') OR (old_battery_id IS NOT NULL AND new_battery_id IS NOT NULL AND return_compartment_id IS NOT NULL AND supply_compartment_id IS NOT NULL AND amount_minor IS NOT NULL))",
      "CHECK ((closed_at IS NOT NULL) = (state IN ('COMPLETED','CANCELLED','CLOSED_COMPENSATED')))",
      "CHECK (state <> 'COMPLETED' OR (return_observed_at IS NOT NULL AND pickup_observed_at IS NOT NULL))"
    ]
  },
